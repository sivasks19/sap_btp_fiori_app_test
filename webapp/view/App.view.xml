<mvc:View
  controllerName="sap.btpfioriodatatest.controller.App"
  displayBlock="true"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
>
  <App>
    <Page title="On-Prem OData Tester">
      <content>
        <VBox class="sapUiSmallMargin" renderType="Bare">
          <core:InvisibleText
            id="proxyPasswordHelp"
            text="Proxy password must match APP_BASIC_AUTH_PASSWORD."
          />
          <MessageStrip
            text="Configure the SAP BTP destination onprem-sap with BasicAuthentication and Proxy Type OnPremise, then use this screen to test GET calls."
            showIcon="true"
          />
          <Label text="Proxy user" />
          <Input
            value="{app>/proxyUser}"
            placeholder="Matches APP_BASIC_AUTH_USER"
          />
          <Label text="Proxy password" />
          <Input
            type="Password"
            ariaLabelledBy="proxyPasswordHelp"
            value="{app>/proxyPassword}"
            placeholder="Matches APP_BASIC_AUTH_PASSWORD"
          />
          <Label text="Service path" />
          <Input
            value="{app>/servicePath}"
            placeholder="/sap/opu/odata/sap/Z_SAMPLE_ODATA_SRV"
          />
          <Label text="Resource path" />
          <Input
            value="{app>/resourcePath}"
            placeholder="$metadata"
          />
          <Button
            press=".onSendRequest"
            text="Send GET request"
            type="Emphasized"
          />
          <ObjectStatus
            state="{app>/statusState}"
            text="{app>/statusText}"
          />
          <TextArea
            editable="false"
            growing="true"
            rows="20"
            value="{app>/responseText}"
            width="100%"
          />
        </VBox>
      </content>
    </Page>
  </App>
</mvc:View>
